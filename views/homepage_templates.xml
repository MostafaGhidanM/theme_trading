<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Homepage Layout Override -->
    <template id="homepage" inherit_id="website.homepage" name="Trading Homepage">
        <!-- Replace default content -->
        <xpath expr="//div[@id='wrap']//main" position="replace">
            <main>
                <!-- Hero Section -->
                <section class="trading-hero bg-gradient-primary text-white">
                    <div class="container">
                        <div class="row align-items-center min-vh-75">
                            <div class="col-lg-6">
                                <h1 class="display-3 fw-bold mb-4">
                                    Start Trading Like a <span class="text-warning">Pro</span>
                                </h1>
                                <p class="lead mb-4">
                                    Access global markets with our advanced trading platform. 
                                    Low spreads, high leverage, and professional tools.
                                </p>
                                <div class="hero-buttons">
                                    <a href="/shop" class="btn btn-warning btn-lg me-3">
                                        <i class="fa fa-rocket me-2"></i>Start Trading
                                    </a>
                                    <a href="#features" class="btn btn-outline-light btn-lg">
                                        Learn More
                                    </a>
                                </div>
                                <!-- Trading Stats -->
                                <div class="trading-stats mt-5">
                                    <div class="row text-center">
                                        <div class="col-4">
                                            <h3 class="fw-bold">500+</h3>
                                            <small>Instruments</small>
                                        </div>
                                        <div class="col-4">
                                            <h3 class="fw-bold">0.1</h3>
                                            <small>Min Spread</small>
                                        </div>
                                        <div class="col-4">
                                            <h3 class="fw-bold">1:500</h3>
                                            <small>Max Leverage</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="hero-image">
                                    <img src="/theme_trading/static/src/img/trading-dashboard.png" class="img-fluid rounded shadow-lg" alt="Trading Platform"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Features Section -->
                <section id="features" class="py-5">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h2 class="display-5 fw-bold">Why Choose Our Platform?</h2>
                            <p class="lead text-muted">Professional trading tools for serious traders</p>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-4">
                                <div class="feature-card text-center p-4">
                                    <div class="feature-icon bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <i class="fa fa-chart-line fa-2x"></i>
                                    </div>
                                    <h4>Advanced Charts</h4>
                                    <p class="text-muted">Professional charting tools with 100+ indicators</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="feature-card text-center p-4">
                                    <div class="feature-icon bg-success text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <i class="fa fa-shield-alt fa-2x"></i>
                                    </div>
                                    <h4>Secure Trading</h4>
                                    <p class="text-muted">Bank-grade security and regulation compliance</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="feature-card text-center p-4">
                                    <div class="feature-icon bg-warning text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <i class="fa fa-bolt fa-2x"></i>
                                    </div>
                                    <h4>Fast Execution</h4>
                                    <p class="text-muted">Lightning-fast order execution in milliseconds</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Popular Products -->
                <section class="bg-light py-5">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h2 class="display-5 fw-bold">Popular Trading Instruments</h2>
                            <p class="lead text-muted">Most traded products on our platform</p>
                        </div>
                        <t t-call="website_sale.products">
                            <t t-set="search" t-value="{'search': '', 'category': 0, 'attrib': 0}"/>
                            <t t-set="limit" t-value="8"/>
                        </t>
                        <div class="text-center mt-4">
                            <a href="/shop" class="btn btn-primary btn-lg">
                                View All Products
                            </a>
                        </div>
                    </div>
                </section>
            </main>
        </xpath>
    </template>
</odoo>